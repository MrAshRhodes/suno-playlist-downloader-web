# client/.env.example — Phase 10 ad-monetisation env vars
#
# Copy this file to client/.env (gitignored) and replace placeholders with
# real values from each network's publisher dashboard. The actual .env file
# is NOT committed — only this template is.
#
# All keys are bundled into the client at build time via Vite's
# import.meta.env.VITE_* convention. Keys are PUBLIC (visible in network
# tab on production); this is tidiness, not security.

# Adsterra publisher dashboard → Websites → [your site] → Banner unit → Code
# The alphanumeric segment of the invoke.js URL: //www.highperformanceformat.com/{KEY}/invoke.js
VITE_ADSTERRA_UNIT_KEY=replace-with-adsterra-banner-unit-key

# Adsterra publisher dashboard → Account → ads.txt (publisher ID column)
VITE_ADSTERRA_PUB_ID=replace-with-adsterra-publisher-id

# Adsterra publisher dashboard → Account → ads.txt (last column of DIRECT line)
VITE_ADSTERRA_TAG_HASH=replace-with-adsterra-cert-authority-hash

# Sovrn dashboard → platform.sovrn.com → Site settings → Signal IID
VITE_SOVRN_SITE_ID=replace-with-sovrn-site-id

# Sovrn dashboard → platform.sovrn.com → Account → Publisher ID for ads.txt
VITE_SOVRN_PUB_ID=replace-with-sovrn-publisher-id
