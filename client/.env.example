# Adsterra Banner Unit Key
# Get from: Adsterra Publisher Dashboard → Ad units → your 728x90 banner unit → "Get code" → atOptions.key
# Format: 32-char hex (e.g. 01204d6c68dff0f3ef9d34b2ee198a8d)
#
# Replit: set as a Secret (Tools → Secrets) — NOT in this file
# Local dev: copy this file to client/.env (gitignored) and paste real key
#
# Vite bundles VITE_* into the client at build time. Adsterra unit keys
# are public (visible in network tab anyway); this is tidiness, not security.
VITE_ADSTERRA_UNIT_KEY=your-adsterra-unit-key-32-char-hex
