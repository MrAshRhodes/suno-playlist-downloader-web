{
  "name": "suno-downloader-web",
  "version": "1.0.0",
  "description": "Web version of Suno Playlist Downloader",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "client": "cd client && npm run dev",
    "client-build": "cd client && npm install && (npm run build || npm run build:static)",
    "client-install": "cd client && npm install",
    "dev-full": "concurrently \"npm run dev\" \"npm run client\"",
    "postinstall": "npm run client-install",
    "build": "npm run client-build",
    "deploy": "npm run client-build && npm start"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "express-session": "^1.18.0",
    "filenamify": "^6.0.0",
    "morgan": "^1.10.0",
    "node-fetch": "^3.3.2",
    "node-id3": "^0.2.6",
    "p-limit": "^4.0.0",
    "puppeteer": "^24.9.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0"
  },
  "overrides": {
    "js-yaml": "4.2.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
